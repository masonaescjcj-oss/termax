# Termax — production Caddyfile (Linux).
# Replaces caddy/Caddyfile, which pointed at a Windows development machine.
# Set DOMAIN via: caddy run --envfile /etc/termax/caddy.env  (DOMAIN=example.com)

{$DOMAIN:localhost} {
    encode gzip zstd

    # API → backend
    handle /api/* {
        reverse_proxy 127.0.0.1:5000
    }

    # Socket.IO (websocket + polling) → backend
    handle /socket.io/* {
        reverse_proxy 127.0.0.1:5000
    }

    # Uploaded images → backend static
    handle /uploads/* {
        reverse_proxy 127.0.0.1:5000
    }

    # Everything else → the exported Expo web build
    handle {
        root * /srv/termax/web
        try_files {path} {path}/ /index.html
        file_server

        @static path /_expo/static/* *.js *.css *.png *.jpg *.jpeg *.svg *.ico *.woff *.woff2
        header @static Cache-Control "public, max-age=31536000, immutable"

        @index path / /index.html
        header @index Cache-Control "public, max-age=0, must-revalidate"
    }

    log {
        output file /var/log/caddy/termax.log
    }
}
