# ==========================================================
# Termax backend — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ==========================================================

# HTTP port the API/socket server listens on
PORT=5000

# --- Auth ---
# Secret used to sign JWTs. Use a long random string.
JWT_SECRET=

# Require new accounts to confirm their email before they can sign in.
# Off for launch. Turning it on is this line plus a restart — the app reads
# the mode from GET /auth/config, so no release is needed. Supabase must
# have email sending configured (Authentication -> Email) for it to work.
REQUIRE_EMAIL_VERIFICATION=false

# Public URL of the web app. Confirmation and password-reset links land here
# (the web build handles `#type=recovery`). Add it to the Supabase project's
# redirect allow-list (Authentication -> URL Configuration) as well.
PUBLIC_APP_URL=

# --- Supabase (primary datastore) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key: server-side only, bypasses RLS. Keep secret.
SUPABASE_SERVICE_KEY=

# --- MongoDB (legacy / models layer) ---
MONGODB_URI=

# --- AI (MaxAI coach, chart analysis, tools insights) ---
# Primary provider (OpenAI-compatible router). Was previously hardcoded in
# toolsController.ts / aiConfigManager.ts — set it here instead.
AI_API_KEY=
AI_BASE_URL=https://router.bynara.id/v1
# Fallback provider
OPENAI_API_KEY=

# ==========================================================
# cTrader Open API
# ==========================================================
# Register an application at https://openapi.ctrader.com/apps — self-service
# and free; Spotware activates it within 24-48h. No broker approval needed.
# The Playground on that page issues an access token for your own cTID
# immediately, which is enough to develop against.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=

# Access token for the trading account whose feed the server streams.
# In simulation mode ONE account is enough — the server holds a single
# connection and fans its quotes out to every app user, who never authenticate
# with cTrader themselves. A demo account works: the quotes are the same.
CTRADER_ACCESS_TOKEN=

# ctidTraderAccountId (numeric). List the accounts behind a token with
# CTraderConnection.getAccessTokenAccounts(), or the Open API playground.
CTRADER_ACCOUNT_ID=

# Which endpoint to use: "demo" -> demo.ctraderapi.com, "live" -> live.ctraderapi.com
CTRADER_ENV=demo

# --- Telegram bot / Mini App ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEB_APP_URL=


# ==========================================================
# Trading behaviour
# ==========================================================
# Animate the price feed between real updates with random drift. Off by
# default: a real broker never invents prices, and synthetic ticks must never
# reach the execution path. When enabled they are emitted to clients only and
# are excluded from stop-loss, take-profit and stop-out processing.
SYNTHETIC_TICKS=false
